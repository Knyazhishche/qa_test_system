# OpenRouter API key (required)
OPENROUTER_API_KEY=your_api_key_here

# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GROK_MODEL=x-ai/grok-4.1-fast
# Set to "false" to disable the reasoning flag sent to Grok
OPENROUTER_REASONING=true

# Notion API (for pulling docs as source)
NOTION_API_KEY=your_notion_api_key_here
# Optional overrides
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2022-06-28
NOTION_PAGE_ID=                       # optional; if set, CLI demo pulls this page

# Postgres + pgvector (preferred persistent store for docs/tests)
POSTGRES_URL=postgres://user:password@localhost:5432/qa_test_system
POSTGRES_SCHEMA=public
# Embedding dimensionality used for pgvector column (must match stored vectors)
EMBEDDING_DIMENSIONS=64
